# Copy to .env and fill in your LangSmith key. .env is gitignored.
#
# Model calls route through the LangChain gateway (never the Anthropic API
# directly). The gateway is authenticated with your LangSmith key, so
# ANTHROPIC_API_KEY and LANGSMITH_API_KEY are the SAME value.

ANTHROPIC_BASE_URL=https://gateway.smith.langchain.com/anthropic
ANTHROPIC_API_KEY=lsv2_pt_your_langsmith_key_here   # gateway auth (= LangSmith key)
LANGSMITH_API_KEY=lsv2_pt_your_langsmith_key_here   # plugin + sandbox
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=harbor-report-demo
