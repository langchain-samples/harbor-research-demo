# Copy to .env and fill in the values below. .env is gitignored.
#
# The agent needs an Anthropic-compatible key. Pick ONE of the two options:

# ── Option A: route through the LangChain gateway (no Anthropic account needed) ──
# The gateway is authenticated with your LangSmith key, so ANTHROPIC_API_KEY and
# LANGSMITH_API_KEY are the SAME value. Leave both lines below uncommented.
ANTHROPIC_BASE_URL=https://gateway.smith.langchain.com/anthropic
ANTHROPIC_API_KEY=lsv2_pt_your_langsmith_key_here   # gateway auth (= LangSmith key)

# ── Option B: call the model provider directly ──
# Comment out the two Option A lines above and use a real Anthropic API key
# instead (langchain-anthropic defaults to api.anthropic.com when no base URL is set):
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_key_here

# ── LangSmith (tracing + the Harbor `--plugin langsmith`; optional if you skip both) ──
LANGSMITH_API_KEY=lsv2_pt_your_langsmith_key_here
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=harbor-report-demo
